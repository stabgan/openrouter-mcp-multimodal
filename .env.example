OPENROUTER_API_KEY=your-api-key-here
# Required for npm run test:integration and CI (GitHub secret: OPENROUTER_API_KEY).

# Live integration tests default to a free fast model unless overridden:
# OPENROUTER_INTEGRATION_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_INTEGRATION_CHAT_MODEL=
# OPENROUTER_INTEGRATION_VISION_MODEL=

# Skip paid-model integration tests (audio/video generation) on zero-credit accounts:
# OPENROUTER_INTEGRATION_SKIP_PAID=1

# Preferred default model:
OPENROUTER_DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free
# Alias (same effect):
# DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free

# Optional — default max_tokens for chat_completion when not specified in the request.
# Leave unset to let the model use its default (which may be the full context window,
# and can trip free-tier quotas on models like Gemini 2.5 Flash Image).
# OPENROUTER_MAX_TOKENS=4096

# Optional — OpenRouter provider routing defaults (v4). All can be overridden per-request
# via the `provider` field on chat_completion. See:
# https://openrouter.ai/docs/features/provider-routing
# OPENROUTER_PROVIDER_QUANTIZATIONS=fp16,int8
# OPENROUTER_PROVIDER_IGNORE=openai,anthropic
# OPENROUTER_PROVIDER_ONLY=anthropic,google             # JSON array or CSV (prefer over ignore)
# OPENROUTER_PROVIDER_SORT=price                        # price | throughput | latency
# OPENROUTER_PROVIDER_ORDER='["meta-llama","google"]'   # JSON array or CSV
# OPENROUTER_PROVIDER_REQUIRE_PARAMETERS=true
# OPENROUTER_PROVIDER_DATA_COLLECTION=deny              # allow | deny
# OPENROUTER_PROVIDER_ALLOW_FALLBACKS=true

# Optional — model list cache TTL in ms (default 3600000 = 1 hour)
# OPENROUTER_MODEL_CACHE_TTL_MS=3600000

# Optional — image pipeline (see README)
# OPENROUTER_IMAGE_MAX_DIMENSION=800
# OPENROUTER_IMAGE_JPEG_QUALITY=80
# OPENROUTER_IMAGE_FETCH_TIMEOUT_MS=30000
# OPENROUTER_IMAGE_MAX_DOWNLOAD_BYTES=26214400
# OPENROUTER_IMAGE_MAX_REDIRECTS=8
# OPENROUTER_IMAGE_MAX_DATA_URL_BYTES=20971520

# Optional — audio pipeline
# text_to_speech defaults to deepgram/flux-tts:free with voice flux-alexis-en.
# Discover current dedicated TTS models with:
# https://openrouter.ai/api/v1/models?output_modalities=speech
# OPENROUTER_AUDIO_FETCH_TIMEOUT_MS=30000
# OPENROUTER_AUDIO_MAX_DOWNLOAD_BYTES=26214400
# OPENROUTER_AUDIO_MAX_REDIRECTS=8
# OPENROUTER_AUDIO_MAX_DATA_URL_BYTES=20971520

# Optional — video pipeline (v3)
# OPENROUTER_DEFAULT_VIDEO_MODEL=google/gemini-2.5-flash       # analyze_video default
# OPENROUTER_DEFAULT_VIDEO_GEN_MODEL=google/veo-3.1            # generate_video default
# OPENROUTER_VIDEO_FETCH_TIMEOUT_MS=60000
# OPENROUTER_VIDEO_MAX_DOWNLOAD_BYTES=104857600
# OPENROUTER_VIDEO_MAX_REDIRECTS=8
# OPENROUTER_VIDEO_MAX_DATA_URL_BYTES=104857600

# Optional — path sandboxes (analyze_* local paths + save_path on generate_* tools)
# OPENROUTER_OUTPUT_DIR=./output
# OPENROUTER_INPUT_DIR=./inputs      # local read sandbox; falls back to OUTPUT_DIR then cwd
# OPENROUTER_ALLOW_UNSAFE_PATHS=1     # disables both sandboxes (legacy v2 behavior)

# Optional — cap text in chat/rerank tool results (chars). Default 512000. Set 0 to disable.
# OPENROUTER_MAX_RESULT_TEXT_CHARS=512000

# Optional — in-memory async chat jobs before eviction (default 200). Set 0 to disable cap.
# OPENROUTER_ASYNC_JOBS_MEMORY_MAX=200

# Optional — logging
# OPENROUTER_LOG_LEVEL=info           # error | warn | info | debug

# Enable OpenRouter response caching by default. Per-request X-OpenRouter-Cache: true header.
# Zero tokens billed on cache hits, 80-300ms latency. Override per-call with `cache: true/false`.
# OPENROUTER_CACHE_RESPONSES=1

# Enable reasoning tokens passthrough by default for DeepSeek R1 / Gemini Thinking / Opus 4.7.
# Adds `_meta.reasoning` to chat_completion responses when the model returned one.
# OPENROUTER_INCLUDE_REASONING=1

# Optional video-generation tuning. Defaults are sensible; override for
# long-running jobs, larger outputs, or faster polling.

# Cap on inline tool-result payloads (bytes). Applies to image and audio when save_path is not set.
# Default 1 MB each. Override globally or per kind:
# OPENROUTER_INLINE_MAX_BYTES=1048576
# OPENROUTER_IMAGE_INLINE_MAX_BYTES=1048576
# OPENROUTER_AUDIO_INLINE_MAX_BYTES=1048576

# Cap on the size of an inline video returned in the tool response (bytes).
# Default 10 MB. Larger outputs always go to save_path and skip inline.
# OPENROUTER_VIDEO_INLINE_MAX_BYTES=10485760

# Cap on the size of a downloaded generated video (bytes).
# Default 256 MB. Prevents runaway downloads.
# OPENROUTER_VIDEO_GEN_MAX_BYTES=268435456

# Default polling interval for video-generation jobs (ms). Minimum 50.
# OPENROUTER_VIDEO_POLL_INTERVAL_MS=15000

# Default maximum time to wait for a video job before returning a resume
# handle (ms). Minimum 10000.
# OPENROUTER_VIDEO_MAX_WAIT_MS=600000

# uvx / pipx launcher only (python/mcp_server_openrouter_multimodal) — pin underlying npm package:
# OPENROUTER_MCP_NPM_VERSION=5.0.1
# OPENROUTER_MCP_NPM_SPEC=/path/to/stabgan-openrouter-mcp-multimodal-5.0.1.tgz
